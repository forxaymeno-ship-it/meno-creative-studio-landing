{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meno-ai-studio",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	// The MongoDB driver needs node:net / node:tls, which nodejs_compat provides.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"ratelimits": [
		{
			"name": "QUOTE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	]
}
